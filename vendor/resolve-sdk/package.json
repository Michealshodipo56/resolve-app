{
  "name": "@resolve-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Resolve prediction market protocol on Stellar/Soroban (vendored build)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
